   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "#Cool\n",
    "x = np.linspace(0, 2*np.pi, 100)\n",
    "plt.plot(x, np.sin(x), label='sin(x)')\n",
    "plt.plot(x, np.cos(x), label='cos(x)')\n",
    "plt.legend()\n",
    "plt.grid()\n",
    "plt.title('Premier graphe')\n",
    "plt.show()"
   ]
  }
